%% estilo.sty
%% Estilo oficial dos Encontros Universitários — Campus da UFC em Quixadá
%% Versão 2026 — reproduzido a partir do modelo Prism disponibilizado pela
%% Comissão Organizadora (Edital n.º 04/2026)
%%
%% Garantia de conformidade com:
%%   · Guia de Normalização de Artigo em Publicação Periódica Científica (UFC)
%%   · ABNT NBR 6022:2018
%%   · ABNT NBR 6023:2018 (referências bibliográficas)

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo}[2026/08/01 v2.1 Estilo EU UFC Quixada]

% ─── FONTES E CODIFICAÇÃO ────────────────────────────────────────────────────
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathptmx}          % Times New Roman texto + math
\RequirePackage[scaled=0.92]{helvet}
\RequirePackage{courier}

% ─── IDIOMA ──────────────────────────────────────────────────────────────────
\RequirePackage[english,brazilian]{babel}
\RequirePackage{csquotes}           % \enquote{}

% ─── GEOMETRIA ───────────────────────────────────────────────────────────────
\RequirePackage[
  a4paper,
  left   = 3.0cm,
  right  = 3.0cm,
  top    = 2.5cm,
  bottom = 2.0cm,
  headheight = 14.5pt
]{geometry}

% ─── ESPAÇAMENTO ─────────────────────────────────────────────────────────────
\RequirePackage{setspace}
\setstretch{1.25}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}

% ─── CORES ───────────────────────────────────────────────────────────────────
\RequirePackage{xcolor}

% ─── MATEMÁTICA ──────────────────────────────────────────────────────────────
\RequirePackage{amsmath,amssymb,amsfonts}
\RequirePackage{bm}

% ─── MICROTYPE ───────────────────────────────────────────────────────────────
\RequirePackage{microtype}

% ─── INDENTAÇÃO DO PRIMEIRO PARÁGRAFO ────────────────────────────────────────
\RequirePackage{indentfirst}

% ─── HIPERLINKS ──────────────────────────────────────────────────────────────
\RequirePackage[hidelinks,colorlinks=false]{hyperref}
\RequirePackage{url}

% ─── GRÁFICOS, TABELAS E LEGENDAS ────────────────────────────────────────────
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{float}

% Formato de legenda conforme ABNT: "Figura X — Título"
\DeclareCaptionLabelSeparator{emdash}{\space---\space}
\captionsetup{
  labelsep       = emdash,
  font           = small,
  labelfont      = {bf},
  justification  = raggedright,
  singlelinecheck= false,
  skip           = 4pt
}
\captionsetup[table]{position=top}
\captionsetup[figure]{position=top}

% ─── LISTAS ──────────────────────────────────────────────────────────────────
\RequirePackage{enumitem}
\setlist{noitemsep, topsep=4pt, parsep=0pt}

% ─── ALGORITMOS ──────────────────────────────────────────────────────────────
\RequirePackage[ruled,vlined,linesnumbered,portuguese]{algorithm2e}
\SetAlCapFnt{\small\bfseries}
\SetAlCapNameFnt{\small\bfseries}
\SetAlFnt{\small}

% ─── CABEÇALHO / RODAPÉ ──────────────────────────────────────────────────────
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% ─── SEÇÕES — ABNT NBR 6022:2018 ─────────────────────────────────────────────
\RequirePackage{titlesec}

% Seção primária: negrito, caixa alta, numerada
\titleformat{\section}
  {\normalfont\normalsize\bfseries}
  {\thesection}
  {1em}
  {\MakeUppercase}
\titlespacing*{\section}{0pt}{1.8ex plus .3ex minus .2ex}{0.8ex plus .1ex}

% Seção secundária: negrito
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}
  {1em}
  {}
\titlespacing*{\subsection}{0pt}{1.4ex plus .2ex minus .1ex}{0.5ex plus .1ex}

% Seção terciária: itálico
\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape}
  {\thesubsubsection}
  {1em}
  {}
\titlespacing*{\subsubsection}{0pt}{1.2ex plus .2ex minus .1ex}{0.4ex plus .1ex}

% ─── REFERÊNCIAS — BIBLATEX + ABNT ───────────────────────────────────────────
\RequirePackage[
  backend     = biber,
  style       = numeric-comp,
  sorting     = nyt,
  maxnames    = 3,
  minnames    = 1,
  giveninits  = true,
  doi         = false,
  url         = false,
  isbn        = false,
  language    = brazilian
]{biblatex}

% ─── MODO REVISÃO (coloração editorial, removível antes da submissão) ─────────
\RequirePackage{etoolbox}
\newbool{reviewenabled}

%% \EnableReviewColors  →  ativa as marcações coloridas de revisão
\newcommand{\EnableReviewColors}{\booltrue{reviewenabled}}

%% \reviewcolor{cor}{texto}  →  exibe texto colorido apenas se review ativo
\newcommand{\reviewcolor}[2]{%
  \ifbool{reviewenabled}{{\color{#1}#2}}{}%
}

% ─── INFORMAÇÃO DO AUTOR ─────────────────────────────────────────────────────
%% \authorinfo{email}  →  insere e-mail como nota de rodapé do autor
\newcommand{\authorinfo}[1]{\thanks{#1}}

% ─── \qabstract — BLOCO RESUMO / ABSTRACT PADRONIZADO ABNT ───────────────────
%% \qabstract{RótuloSeção}{RótuloPalavrasChave}{RótuloODS}
%%           {TextoDoResumo}{Palavras-chave}{ODS}
\newcommand{\qabstract}[6]{%
  \vspace{0.6em}%
  \noindent{\normalfont\normalsize\bfseries\MakeUppercase{#1}}\par%
  \vspace{0.3em}%
  \noindent #4\par%
  \vspace{0.4em}%
  \noindent\textbf{#2:} #5\par%
  \vspace{0.2em}%
  \noindent\textbf{#3:} #6\par%
  \vspace{1.0em}%
}

% ─── \qcentersection — SEÇÃO CENTRALIZADA SEM NUMERAÇÃO ──────────────────────
%% \qcentersection{TÍTULO}  →  p. ex. AGRADECIMENTOS (opcional)
\newcommand{\qcentersection}[1]{%
  \vspace{1.5ex}%
  \begin{center}%
    {\normalfont\normalsize\bfseries\MakeUppercase{#1}}%
  \end{center}%
  \vspace{0.5ex}%
}

\endinput
